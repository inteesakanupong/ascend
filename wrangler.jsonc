{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ascend",
  "compatibility_date": "2026-05-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".wrangler/**",
      "Ascend/**",
      "docs/**",
      "node_modules/**",
      "ppal_training_reference_database.json",
      "ppal_training_reference_notes.md"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
